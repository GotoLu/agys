{
  "name": "agy-account",
  "version": "0.1.0",
  "description": "Local multi-account credential snapshot, quota monitor & switcher for Google Antigravity Desktop and agy CLI on macOS",
  "license": "MIT",
  "homepage": "https://github.com/GotoLu/agys-switcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GotoLu/agys-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/GotoLu/agys-switcher/issues"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "agy",
    "agy-cli",
    "agys",
    "multi-account",
    "account-switcher",
    "quota",
    "macos",
    "keychain",
    "cli"
  ],
  "type": "module",
  "bin": {
    "agy-account": "./dist/cli.js",
    "agys": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
